{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenou Tweaks",
  "version": "1.0.0",
  "identifier": "com.zenou.tweaks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zenou Tweaks",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
